    <bpmn:sequenceFlow id="SF_O67_0" sourceRef="S3" targetRef="T41" />
    <bpmn:sequenceFlow id="SF_O67_1" sourceRef="T41" targetRef="T42" />
    <bpmn:sequenceFlow id="SF_O67_2" sourceRef="T42" targetRef="T43" />
